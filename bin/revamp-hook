#!/usr/bin/env python3
"""revamp-hook — send an agent harness's activity to REVamp.

Wire it into a harness's hooks:

    revamp-hook <source> <event>

<source> names the harness (codex, cursor, agy, omp, pi, opencode...).
<event> is one of:
    session_start  session_end
    tool_start     tool_end
    approval       (the harness is waiting for the user to approve something)

The hook's JSON (on stdin, if any) supplies the tool name and a short preview.
It never blocks or changes the harness: it prints nothing, always exits 0, and
hands the post to a detached `revampctl event` so the harness never waits.
"""
from __future__ import annotations

import json
import os
import select
import subprocess
import sys

EVENTS = {
    "session_start": "session_start",
    "session_end": "session_end",
    "tool_start": "tool_start",
    "tool_end": "tool_end",
    "approval": "approval_request",
}


def read_payload() -> dict:
    try:
        if sys.stdin is None or sys.stdin.isatty():
            return {}
        ready, _, _ = select.select([sys.stdin], [], [], 0.2)
        if not ready:
            return {}
        # Read only what the first JSON document needs: a plain read() would wait
        # for EOF, and a harness may keep the pipe open long after the payload.
        # os.read returns as soon as ANY bytes arrive; the buffered read(n) below
        # would instead block until the full n or EOF.
        buf = b""
        fd = sys.stdin.fileno()
        decoder = json.JSONDecoder()
        while len(buf) < 1_000_000:
            more = os.read(fd, 4096)
            if not more:
                break  # EOF: all we will ever get
            buf += more
            try:
                data, _end = decoder.raw_decode(buf.decode("utf-8", "replace"))
                return data if isinstance(data, dict) else {}
            except (json.JSONDecodeError, UnicodeDecodeError):
                continue  # incomplete: keep reading
        return {}
    except Exception:
        return {}


def mask_secrets(text: str) -> str:
    """Mask credential values before a preview is persisted or displayed."""
    import re
    pat = re.compile(r"((?:authorization|api[-_]?key|api[-_]?secret|token|secret|password|passwd|pwd"
                     r"|bearer|basic)[-_ ]?[=: ]*(?:bearer|basic)?[ \t]*)(?:[^\s'\"]+)", re.IGNORECASE)
    try:
        return pat.sub(lambda m: f"{m.group(1)}***", text)
    except Exception:
        return text


def tool_and_preview(p: dict) -> tuple[str, str]:
    tool = p.get("tool_name") or p.get("toolName") or p.get("tool") or ""
    inp = p.get("tool_input") or p.get("toolInput") or p.get("input") or {}
    preview = ""
    if isinstance(inp, dict):
        preview = str(inp.get("command") or inp.get("file_path") or inp.get("path") or inp.get("description") or "")
    preview = preview or str(p.get("command") or p.get("message") or "")
    return str(tool)[:40], mask_secrets(" ".join(preview.split()))[:80]


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] not in EVENTS:
        return 0
    source, kind = argv[0][:32], EVENTS[argv[1]]
    tool, preview = tool_and_preview(read_payload())
    cmd = ["revampctl", "event", kind, tool or "-", preview]
    env = dict(os.environ, REVAMP_SOURCE=source)
    try:
        subprocess.Popen(cmd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Exception:
        pass
    sys.exit(0)
